# Example for `docker compose` (see docker-compose.yml).
#
# This is where REAL values go, unlike .env.railway: Railway template syntax
# (`${{...}}`) is not expanded outside Railway, so every line here must be
# literal. Generate the key with:  openssl rand -hex 32
#
# Both of these are required by the app.
CARTETHYIA_ENCRYPTION_KEY=
CARTETHYIA_PUBLIC_ORIGIN=http://localhost:12800

# lite = embedded SQLite on the mounted volume.
CARTETHYIA_DB_MODE=lite
PORT=12800
NODE_ENV=production
